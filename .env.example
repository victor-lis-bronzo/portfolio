# Groq API key — required only for the whiteboard assistant (/api/chat).
# Get a free one at https://console.groq.com/keys. Server-only: never prefix it
# with NEXT_PUBLIC_, or Next.js will inline it into the client bundle.
GROQ_API_KEY=

# Optional. Overrides the Groq chat model. Defaults to openai/gpt-oss-20b.
# See https://console.groq.com/docs/models for the current list of free-tier models.
# GROQ_MODEL=

# Optional. Canonical site origin used by metadata, robots.txt and the sitemap.
# Defaults to https://victorlisbronzo.me.
# NEXT_PUBLIC_SITE_URL=
