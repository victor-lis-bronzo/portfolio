<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>{{name}} - Currículo</title>
  <style>
    @page {
      size: A4;
      margin: 12mm 15mm;
    }
    
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #111827;
      background-color: #ffffff;
      font-size: 10.5pt;
      line-height: 1.45;
    }

    .header {
      border-bottom: 2px solid #111827;
      padding-bottom: 8px;
      margin-bottom: 12px;
    }

    .name {
      font-size: 20pt;
      font-weight: bold;
      color: #111827;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .position {
      font-size: 12pt;
      font-weight: 600;
      color: #374151;
      margin-top: 2px;
    }

    .contact-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      font-size: 9pt;
      color: #4b5563;
      margin-top: 6px;
    }

    .contact-item {
      display: inline-block;
    }

    .contact-item:not(:last-child)::after {
      content: " •";
      margin-left: 8px;
      color: #9ca3af;
    }

    .contact-item a {
      color: #1d4ed8;
      text-decoration: none;
    }

    .section {
      margin-bottom: 12px;
    }

    .section-title {
      font-size: 11pt;
      font-weight: bold;
      text-transform: uppercase;
      color: #111827;
      border-bottom: 1px solid #d1d5db;
      padding-bottom: 3px;
      margin-bottom: 8px;
      letter-spacing: 0.5px;
    }

    .summary-text {
      font-size: 10pt;
      color: #1f2937;
      text-align: justify;
    }

    .item {
      margin-bottom: 8px;
    }

    .item-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-weight: bold;
    }

    .item-title {
      font-size: 10.5pt;
      color: #111827;
    }

    .item-subtitle {
      font-size: 9.5pt;
      font-weight: 600;
      color: #374151;
    }

    .item-date {
      font-size: 9pt;
      color: #4b5563;
      font-weight: normal;
      white-space: nowrap;
    }

    .item-description {
      font-size: 9.5pt;
      color: #374151;
      margin-top: 2px;
    }

    .achievements {
      margin-top: 4px;
      margin-left: 18px;
    }

    .achievements li {
      font-size: 9.5pt;
      color: #1f2937;
      margin-bottom: 2px;
    }

    .tech-tags {
      font-size: 9pt;
      color: #4b5563;
      margin-top: 3px;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .skill-group {
      font-size: 9.5pt;
    }

    .skill-title {
      font-weight: bold;
      color: #111827;
    }

    .skill-list {
      color: #374151;
    }

    .simple-list {
      margin-left: 18px;
    }

    .simple-list li {
      font-size: 9.5pt;
      color: #1f2937;
      margin-bottom: 2px;
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <div class="header">
    <div class="name">{{name}}</div>
    <div class="position">{{position}}</div>
    <div class="contact-bar">
      {{#if email}}<span class="contact-item">📧 {{email}}</span>{{/if}}
      {{#if contactInformation}}<span class="contact-item">📱 {{contactInformation}}</span>{{/if}}
      {{#if address}}<span class="contact-item">📍 {{address}}</span>{{/if}}
      {{#each socialMedia}}
        <span class="contact-item"><a href="{{link}}">{{socialMedia}}</a></span>
      {{/each}}
    </div>
  </div>

  <!-- SUMMARY -->
  {{#if summary}}
  <div class="section">
    <div class="section-title">Resumo Profissional</div>
    <p class="summary-text">{{summary}}</p>
  </div>
  {{/if}}

  <!-- WORK EXPERIENCE -->
  {{#if workExperience.length}}
  <div class="section">
    <div class="section-title">Experiência Profissional</div>
    {{#each workExperience}}
    <div class="item">
      <div class="item-header">
        <span class="item-title">{{position}} — {{company}}</span>
        <span class="item-date">{{startYear}} – {{endYear}}</span>
      </div>
      {{#if description}}
      <p class="item-description">{{description}}</p>
      {{/if}}
      {{#if keyAchievements}}
      <ul class="achievements">
        <li>{{keyAchievements}}</li>
      </ul>
      {{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}

  <!-- EDUCATION -->
  {{#if education.length}}
  <div class="section">
    <div class="section-title">Formação Acadêmica</div>
    {{#each education}}
    <div class="item">
      <div class="item-header">
        <span class="item-title">{{degree}}</span>
        <span class="item-date">{{startYear}} – {{endYear}}</span>
      </div>
      <div class="item-subtitle">{{school}}</div>
    </div>
    {{/each}}
  </div>
  {{/if}}

  <!-- PROJECTS -->
  {{#if projects.length}}
  <div class="section">
    <div class="section-title">Projetos em Destaque</div>
    {{#each projects}}
    <div class="item">
      <div class="item-header">
        <span class="item-title">{{name}}{{#if link}} (<a href="{{link}}" style="color: #1d4ed8; text-decoration: none;">Link</a>){{/if}}</span>
      </div>
      <p class="item-description">{{description}}</p>
      {{#if technologies.length}}
      <div class="tech-tags"><strong>Tecnologias:</strong> {{#each technologies}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>
      {{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}

  <!-- SKILLS -->
  {{#if skills.length}}
  <div class="section">
    <div class="section-title">Habilidades Técnicas</div>
    <div class="skills-grid">
      {{#each skills}}
      <div class="skill-group">
        <span class="skill-title">{{title}}:</span>
        <span class="skill-list">{{#each skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>
      </div>
      {{#each subCategories}}
      <div class="skill-group" style="margin-left: 12px;">
        <span class="skill-title">{{title}}:</span>
        <span class="skill-list">{{#each skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>
      </div>
      {{/each}}
      {{/each}}
    </div>
  </div>
  {{/if}}

  <!-- LANGUAGES -->
  {{#if languages.length}}
  <div class="section">
    <div class="section-title">Idiomas</div>
    <ul class="simple-list">
      {{#each languages}}
      <li>{{this}}</li>
      {{/each}}
    </ul>
  </div>
  {{/if}}

  <!-- CERTIFICATIONS -->
  {{#if certifications.length}}
  <div class="section">
    <div class="section-title">Certificações & Cursos</div>
    <ul class="simple-list">
      {{#each certifications}}
      <li>{{this}}</li>
      {{/each}}
    </ul>
  </div>
  {{/if}}

</body>
</html>
